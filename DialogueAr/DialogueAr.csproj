<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <Author>ALHABSI</Author>
    <Name>DialogueAr</Name>
    <Punchline>Offline English→any-language dialogue translator for Talk, BattleTalk, and cutscenes.</Punchline>
    <Description>Hooks Talk, BattleTalk, and TalkSubtitle, translates English dialogue locally with Helsinki-NLP Opus-MT on disk (Arabic, French, Japanese, and many more — no cloud translation API), and shows an ImGui overlay with optional TTS.</Description>
    <PackageTags>translation;dialogue;offline;multilingual</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Models\translate_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\setup-models.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ArabicRt" Version="0.1.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>
</Project>
