<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyName>Lisan</AssemblyName>
    <RootNamespace>Lisan</RootNamespace>
    <InternalName>Lisan</InternalName>
    <Author>ALHABSI</Author>
    <Name>Lisan</Name>
    <Punchline>Hear Eorzea in your own tongue. Offline dialogue translation, made with love at habsi.net.</Punchline>
    <Description>Lisan (لسان — tongue, language) listens to Talk, BattleTalk, cutscene subtitles, and dialogue choices, then translates English locally with Helsinki-NLP Opus-MT on your PC. History, copy, optional Arabic TTS. No cloud translation. A small gift from habsi.net.</Description>
    <RepoUrl>https://github.com/dev-habsi/Lisan</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/dev-habsi/Lisan/main/Lisan/images/icon.png</IconUrl>
    <Tags>translation;dialogue;offline;arabic;japanese;chinese;accessibility;localization</Tags>
    <CategoryTags>ui;utility</CategoryTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Models\translate_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\setup-models.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- Plugin installer icon; DalamudPackager zips whatever is in the output folder. -->
    <Content Include="images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ArabicRt" Version="0.1.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>
</Project>
