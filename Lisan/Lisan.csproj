<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.4.0.0</Version>
    <AssemblyName>Lisan</AssemblyName>
    <RootNamespace>Lisan</RootNamespace>
    <InternalName>Lisan</InternalName>
    <Author>ALHABSI</Author>
    <Name>Lisan</Name>
    <Punchline>Hear Eorzea in your own tongue. Offline dialogue translation, made with love at habsi.net.</Punchline>
    <Description>Lisan (لسان — tongue, language) listens to Talk, BattleTalk, and cutscene subtitles, then translates English locally with Helsinki-NLP Opus-MT on your PC. No cloud translation. Arabic, French, Japanese, and many more. A small gift from habsi.net.</Description>
    <RepoUrl>https://habsi.net</RepoUrl>
    <Tags>translation;dialogue;offline;arabic;accessibility</Tags>
    <CategoryTags>ui;utility</CategoryTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Models\translate_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\setup-models.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Arabic pack (skip rust/tf mirrors — only pytorch weights are used). -->
    <Content Include="Models\opus-mt-en-ar\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\generation_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\tokenizer_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\vocab.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\source.spm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\target.spm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\opus-mt-en-ar\pytorch_model.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ArabicRt" Version="0.1.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>
</Project>
